# Copy to server/.env for local development.
# docker-compose.yml (repo root) only runs Postgres - this file configures
# the Express server + MCP server that you run yourself with npm.

# Port 5433 (not 5432) because docker-compose.yml maps it that way -
# handy if you already have another Postgres using 5432 locally.
DATABASE_URL=postgresql://taskapp:taskapp@localhost:5433/taskapp

# Port the Express API listens on.
PORT=4000

# Any long random string - used to sign session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth
# client ID (Web application). See README "Google sign-in setup".
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Only needed to run the MCP server locally over stdio (npm run mcp).
# Must match the email of a Google account that has already signed into
# the web app once. Not used by the remote /mcp HTTP route - that one
# authenticates each request with a per-user personal access token
# instead (generate one from the web app once signed in).
MCP_USER_EMAIL=you@example.com
